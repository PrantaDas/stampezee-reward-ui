{
  "name": "stampezee-reward-ui",
  "version": "0.4.0",
  "description": "StampEzee reward UI for React: a glowing ripple badge and a scratch-to-reveal ticket card, both with falling-glitter confetti.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "stampezee",
    "scratch-card",
    "ripple",
    "confetti",
    "glitter",
    "reward"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3000",
    "test": "node test_scratch.mjs",
    "build": "vite build && cp src/index.d.ts dist/index.d.ts",
    "preview": "vite preview",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
